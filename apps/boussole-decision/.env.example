# Projet Supabase (Paramètres du projet → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Adresse publique du site (liens envoyés par email)
NEXT_PUBLIC_SITE_URL=https://www.magichumans.com

# Ma Cible (serveur uniquement, jamais NEXT_PUBLIC_)
MA_CIBLE_FOURNISSEUR=anthropic        # anthropic | openai | gemini
MA_CIBLE_MODELE=claude-sonnet-5       # nom exact du modèle ; vide et gemini : gemini-2.5-flash
ANTHROPIC_API_KEY=                    # si fournisseur anthropic
OPENAI_API_KEY=                       # si fournisseur openai
GEMINI_API_KEY=                       # si fournisseur gemini (clé gratuite : https://aistudio.google.com/apikey)
MA_CIBLE_SEL=                         # 32 caractères aléatoires au moins (openssl rand -hex 32)
SUPABASE_SECRET_KEY=                  # clé secrète Supabase (Paramètres → API), pour le compteur anti-abus
MA_CIBLE_MAX_IP_CADRAGE=8
MA_CIBLE_MAX_IP_RESULTAT=3
MA_CIBLE_MAX_GLOBAL_CADRAGE=600
MA_CIBLE_MAX_GLOBAL_RESULTAT=200
