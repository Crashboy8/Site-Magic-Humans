{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/apps",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/apps/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/apps/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ma-cible",
      "destination": "/boussole-decision/ma-cible/",
      "permanent": false
    },
    {
      "source": "/ma-cible/",
      "destination": "/boussole-decision/ma-cible/",
      "permanent": false
    },
    {
      "source": "/ma-cible/:path*",
      "destination": "/boussole-decision/ma-cible/",
      "permanent": false
    },
    {
      "source": "/mon-espace",
      "destination": "/boussole-decision/mon-espace/",
      "permanent": false
    },
    {
      "source": "/mon-espace/",
      "destination": "/boussole-decision/mon-espace/",
      "permanent": false
    },
    {
      "source": "/mon-espace/:path*",
      "destination": "/boussole-decision/mon-espace/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/boussole-decision",
      "destination": "https://boussole-decision.vercel.app/boussole-decision/"
    },
    {
      "source": "/boussole-decision/(.*)",
      "destination": "https://boussole-decision.vercel.app/boussole-decision/$1"
    }
  ],
  "headers": [
    {
      "source": "/carte-du-talent/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
